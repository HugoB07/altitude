{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowJs": true,

    // Two of the base's options are turned off here, and only here.
    //
    // Both fail almost entirely inside `src/components/ui`, which is generated
    // by the shadcn CLI and is meant to stay as generated - a fix applied there
    // is reverted by the next `shadcn add`. The remaining failures come from
    // react-day-picker's own types, which are not written against
    // exactOptionalPropertyTypes and are not ours to change.
    //
    // Nothing safety-carrying is given up. noPropertyAccessFromIndexSignature
    // is a spelling rule for index signatures. The base's real guarantees -
    // strict, noUncheckedIndexedAccess, noUnusedLocals, noImplicitReturns -
    // all apply, and cost nothing: the app already satisfies them.
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,

    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
