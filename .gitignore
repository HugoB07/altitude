# ── Dependencies ───────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ── Build ──────────────────────────────────────────────────────────────
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ── Tests & coverage ───────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# ── Environment & secrets ──────────────────────────────────────────────
# NEVER commit a secret: see docs/plan §14.1 (file-based Docker secrets)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
!**/*.key.example

# ── Local data ─────────────────────────────────────────────────────────
pgdata/
data/
uploads/
*.sqlite
*.sqlite3
*.dump
*.sql.gz
backups/

# ── Generated documents ────────────────────────────────────────────────
# Sources live in docs/plan/parts/; the concatenated HTML and the PDF are
# build artefacts, regenerated by docs/plan/build-pdf.mjs.
docs/plan/altitude-plan.html
docs/plan/*.pdf

# ── Tooling & OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
pnpm-debug.log*
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
