# Keep the node_modules tree strict: a package may only import what it declares.
# Catches "works on my machine" bugs caused by hoisted transitive dependencies.
hoist=false
strict-peer-dependencies=false

# Never let a postinstall script run without being noticed.
enable-pre-post-scripts=false

# Exact versions in the lockfile; ranges belong in package.json, not in what ships.
save-exact=false
resolution-mode=highest
