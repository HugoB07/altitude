    },
    {
      "$comment": "Credit and insurance under a supermarket's name. Named but not categorised: it is a loan payment for one household and an insurance premium for the next, and stopping here is what keeps it out of the weekly shop.",
      "id": "carrefour-banque",
      "name": "Carrefour Banque",
      "priority": 14,
      "when": {
        "descriptionMatches": "\\bCARREFOUR\\s?(BANQUE|ASSURANCE)\\b"
      },
      "then": {
        "counterparty": "Carrefour Banque"
      },
      "stopOnMatch": true
    },
