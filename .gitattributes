# Normalise line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Scripts that must stay LF even on Windows
*.sh   text eol=lf
*.mjs  text eol=lf

# Windows-native files
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binaries — never converted
*.pdf  binary
*.png  binary
*.jpg  binary
*.woff binary
*.woff2 binary
*.ico  binary

# Generated files: excluded from language stats and noisy diffs
docs/plan/altitude-plan.html linguist-generated=true
pnpm-lock.yaml               linguist-generated=true
