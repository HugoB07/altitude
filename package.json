{
  "name": "altitude",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hosted wealth tracking",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoB07/altitude.git"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "db:check": "pnpm --filter @altitude/db exec drizzle-kit check",
    "db:down": "docker compose -f docker/docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker/docker-compose.dev.yml down -v && pnpm db:up",
    "db:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "lint": "pnpm lint:boundaries && pnpm lint:code",
    "lint:boundaries": "depcruise packages --config .dependency-cruiser.cjs && pnpm --filter @altitude/web exec depcruise src --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json",
    "lint:code": "pnpm --filter @altitude/web exec eslint --max-warnings 0",
    "plan": "cd docs/plan && node build-html.mjs && node build-pdf.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run packages/shared packages/core --exclude \"**/*.db.test.ts\" --coverage",
    "test:db": "vitest run packages/db .db.test.ts",
    "test:unit": "vitest run packages/shared packages/core --exclude \"**/*.db.test.ts\"",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "fast-check": "^4.1.1",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
