# Copy to .env.local for development. Never commit a filled-in copy.
# Production uses file-based Docker secrets instead - development plan §14.1.

# -- Database -----------------------------------------------------------
# Port 55432, not 5432, to avoid colliding with a natively installed PostgreSQL.
# Dev credentials, weak on purpose.
#
# The role is altitude_app, NOT altitude. The role a Postgres image creates from
# POSTGRES_USER is a superuser, and superusers ignore row-level security
# entirely - households would not be isolated, silently, with every policy
# still listed in pg_policies. The application refuses to start on such a role
# (assertTenantScopingActive), but the right value is this one.
DATABASE_URL="postgres://altitude_app:altitude_app@localhost:55432/altitude"

# Migrations only. This role has BYPASSRLS, which they need and the app must not have.
MIGRATE_DATABASE_URL="postgres://altitude_migrate:altitude_migrate@localhost:55432/altitude"

# Only the end-to-end run needs this, and only to CREATE and DROP its own
# database - neither application role may, by design (ADR-0007). The compose
# file's superuser is the one to point it at; the database in the URL is
# ignored, since the run connects to `postgres` to create its own.
E2E_ADMIN_DATABASE_URL="postgres://altitude:altitude@localhost:55432/altitude"

# -- Application --------------------------------------------------------
ALTITUDE_BASE_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The currency the first-run wizard offers, changeable per household afterwards
# (plan §14.1). Optional: left out, it is EUR. Three to ten letters - ISO 4217
# for fiat, or the ticker for crypto, which the ledger counts as a currency
# (plan §11.3). Set to something that is neither and the wizard refuses to
# render rather than quietly starting your households in euros.
ALTITUDE_BASE_CURRENCY="EUR"

# -- Reserved - read by nothing yet -------------------------------------
# Listed because the plan specifies them (§14.1) and the design depends on them,
# and marked because filling one in today changes nothing.

# Encrypts account numbers and connector tokens, once either exists (plan §5.3).
ALTITUDE_ENCRYPTION_KEY=""

# -- Outbound providers - reserved too, all optional, all off by default -
# Read by nothing yet either: there is no market data and no connector until
# phases 3 and 7. Written down now because the defaults are the decision - off,
# and an instance that never reaches the internet has to stay fully usable.
#
# true blocks every outbound call; the app stays fully usable (plan §13.2).
ALTITUDE_OFFLINE="true"

# Ordered list with fallback. Empty means prices are entered manually.
ALTITUDE_PRICE_PROVIDERS=""

# European Central Bank: free, official, no API key.
ALTITUDE_FX_PROVIDER="ecb"

# Empty means no bank connection is possible at all (plan §7.7).
ALTITUDE_CONNECTORS=""

# Empty means no email; the app degrades silently rather than erroring.
SMTP_URL=""
